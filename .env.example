# Supabase Realtime — the browser talks to Supabase directly.
# The anon key is a publishable key, meant to sit in the browser.
# Copy to .env.local for local dev; add both to the Vercel project settings for deploys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
